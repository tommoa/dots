@@ -90,3 +90,19 @@ func TestBuildConfigModelsPropagatesMaxContextLength(t *testing.T) {
 		})
 	}
 }
+
+func TestBuildCodexConfigModelsPropagatesInputModalities(t *testing.T) {
+	models := buildCodexConfigModels(&config.CodexKey{
+		Models: []config.CodexModel{{
+			Name:            "codex-upstream",
+			Alias:           "codex-alias",
+			InputModalities: []string{"TEXT", "image", "image"},
+		}},
+	})
+	if len(models) != 1 {
+		t.Fatalf("model count = %d, want 1", len(models))
+	}
+	if got := joinModalities(models[0].SupportedInputModalities); got != "text,image" {
+		t.Fatalf("SupportedInputModalities = %q, want text,image", got)
+	}
+}
