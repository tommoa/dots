diff --git a/src/modules/idle_inhibitor.cpp b/src/modules/idle_inhibitor.cpp
--- a/src/modules/idle_inhibitor.cpp
+++ b/src/modules/idle_inhibitor.cpp
@@ -1,5 +1,7 @@
 #include "modules/idle_inhibitor.hpp"

+#include <csignal>
+
 #include "idle-inhibit-unstable-v1-client-protocol.h"
 #include "util/command.hpp"

@@ -78,6 +80,27 @@ auto waybar::modules::IdleInhibitor::update() -> void {
   ALabel::update();
 }

+auto waybar::modules::IdleInhibitor::refresh(int signal) -> void {
+  if (config_["signal"].isInt() && signal == SIGRTMIN + config_["signal"].asInt()) {
+    // Waybar dispatches to every bar, but inhibition state is process-wide.
+    // Only the first instance listening to this signal owns the transition.
+    for (auto* module : waybar::modules::IdleInhibitor::modules) {
+      auto* inhibitor = static_cast<IdleInhibitor*>(module);
+      if (inhibitor->config_["signal"].isInt() &&
+          signal == SIGRTMIN + inhibitor->config_["signal"].asInt()) {
+        if (inhibitor != this) {
+          return;
+        }
+        break;
+      }
+    }
+    toggleStatus();
+    for (auto const& module : waybar::modules::IdleInhibitor::modules) {
+      module->update();
+    }
+  }
+}
+
 void waybar::modules::IdleInhibitor::toggleStatus() {
   status = !status;

