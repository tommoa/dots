#!/bin/sh

# NOTMUCH_CONFIG is set by notmuch when running hooks
if [ -z "${NOTMUCH_CONFIG}" ]; then
    echo "Error: NOTMUCH_CONFIG is not set. This hook must be run via notmuch." >&2
    exit 1
fi

conf_file="${NOTMUCH_CONFIG}"
mbdir="${conf_file##*/}"
dir=$(notmuch config get database.path) || exit "$?"

# The folder that will be used for incoming mail. This needs to match the
# directory on disk, including its case.
inbox=$(notmuch config get user.inbox) || exit "$?"
if [ -z "${inbox}" ]; then
    printf 'Error: user.inbox must name the physical inbox folder\n' >&2
    exit 1
fi
inbox_query="folder:\"${inbox}\""

notify_send() {
    osascript -e 'on run argv
    display notification item 1 of argv
end run' "$@"
}

case $(uname -s) in
    Darwin)
        notification=notify_send
        ;;
    Linux)
        notification="notify-send"
        ;;
esac

# Are we using gmail or not?
gmail=$(notmuch config get user.type 2>/dev/null)

# The folder that will be used for trash
trash=$(notmuch config get user.trash) || exit "$?"
# The folder that will be used for archiving
archive=$(notmuch config get user.archive) || exit "$?"
# The folder that will be used for sent mail
sent=$(notmuch config get user.sent) || exit "$?"

tags="$(notmuch config get user.folder_tags 2>/dev/null)"

move_to_folder() {
    file="$1"
    folder="$2"

    # A previous step in this hook may already have moved this path.
    [ -f "${file}" ] || return 0

    name="${file##*/}"
    flags="${name##*:}"
    directory=${file%%/${name}}
    # If its in the "new" directory, we need to set the flags ourselves
    if [ "${directory##*/}" = "new" ]; then flags="2,"; fi

    destination="${dir}/${folder}/cur/$(uuidgen):${flags%%T}"
    if mv "${file}" "${destination}"; then
        printf "Moved %s to %s\n" "${file}" "${folder}"
    else
        printf "Failed to move %s to %s; retaining the source\n" "${file}" "${folder}" >&2
        return 1
    fi
}

folder_to_tag() {
    # Usage: folder_to_tag "tag" "folder"
    folder="$2"
    tag="$1"
    query="folder:\"${folder}\" and not tag:${tag}"
    if [ "${tag}" = "archive" ]; then
        query="${query} and not tag:draft"
    fi
    notmuch tag "+${tag}" -- "${query}"
}

ensure_tag_in_folder() {
    # Usage: ensure_tag_in_folder "tag" "folder"
    folder="$2"
    tag="$1"
    notmuch tag "-${tag}" -- "tag:${tag}" and not folder:"\"${folder}\""
}

# If its already in trash, remove it from the inbox
notmuch tag +deleted -inbox -- folder:"\"${trash}\""
# If its been sent, pass that on through
notmuch tag +sent -unread -- folder:"\"${sent}\"" and not tag:sent

# A maildir filename ending in T means that a client has marked the message
# deleted. Move it to the configured trash folder instead of removing it.
while IFS= read -r file && [ -n "${file}" ];
do
    move_to_folder "${file}" "${trash}"
done <<eof
$(notmuch search --output=files tag:inbox | grep 'T$' || true)
eof
# If its already been archived, mark it as such
notmuch tag +archive -inbox -- folder:"\"${archive}\"" and not "${inbox_query}" and not tag:archive and not tag:draft
# If mail comes back into the inbox on the server, put it back here too.
# A local archive removed its inbox copy before mbsync ran, so a copy here
# now means it's back in the inbox. Don't restore deleted mail.
notmuch tag +inbox -archive -- "${inbox_query}" and not tag:deleted and "(not tag:inbox or tag:archive)"
# If its not in an inbox, don't mark it as "inbox"
notmuch tag -inbox -- tag:inbox and not "${inbox_query}"

while IFS= read -r tag && [ -n "${tag}" ];
do
    folder_to_tag "${tag}" "$(notmuch config get user."${tag}")"
    ensure_tag_in_folder "${tag}" "$(notmuch config get user."${tag}")"
done <<eof
${tags}
eof

folder_to_tag "sent" "${sent}"
[ -z "${gmail}" ] && folder_to_tag "archive" "${archive}"
ensure_tag_in_folder "sent" "${sent}"
ensure_tag_in_folder "archive" "${archive}"

# When deleting emails straight from gmail (say on mobile), then they
# get given the "trashed" IMAP flag and are copied to the trash folder.
# As such, when we see such emails, we need to make sure they are
# properly deleted.
# These emails will be retagged below
while IFS= read -r file && [ -n "${file}" ];
do
    move_to_folder "${file}" "${trash}"
done <<eof
$(notmuch search --output=files tag:deleted and not folder:"\"${trash}\"")
eof

# Retag things that have been deleted
notmuch tag -archive -inbox -- tag:deleted and "(tag:archive or tag:inbox $(printf "${tags}" | sed 's/^/or tag:/'))"

[ -x "${dir}/.notmuch/hooks/${mbdir}.post-new" ] &&
    . "${dir}/.notmuch/hooks/${mbdir}.post-new"

notmuch new --no-hooks

count=$(notmuch count tag:unread)
[ "${count:-0}" -gt 0 ] && ${notification} "${mbdir}: ${count} new emails" || true
