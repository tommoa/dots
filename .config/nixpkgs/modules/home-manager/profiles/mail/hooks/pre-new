#!/bin/sh
# This file does some preprocessing for notmuch by putting some special tags
# in the correct maildir directories.

# It requires some special setup to work correctly:
#  - notmuch configurations are in .config/notmuch/{name}
#  - database.path names the account's Maildir root
#  - the mbsync channel that needs to be run is called {name}
#  - if gmail is being used, `notmuch config set user.type gmail` has been run
#  - user.inbox, archive, sent and trash name the physical folders
#    (including their case); defaults are resolved in notmuch.nix
#  - hook_dir is set to ~/.config/notmuch/runtime-hooks in the notmuch config

# NOTMUCH_CONFIG is set by notmuch when running hooks
if [ -z "${NOTMUCH_CONFIG}" ]; then
    echo "Error: NOTMUCH_CONFIG is not set. This hook must be run via notmuch." >&2
    exit 1
fi

conf_file="${NOTMUCH_CONFIG}"
mbdir="${conf_file##*/}"
dir=$(notmuch config get database.path) || exit "$?"

# The folder that will be used for incoming mail. This needs to match the
# directory on disk, including its case.
inbox=$(notmuch config get user.inbox) || exit "$?"
if [ -z "${inbox}" ]; then
    printf 'Error: user.inbox must name the physical inbox folder\n' >&2
    exit 1
fi

# Are we using gmail or not?
gmail=$(notmuch config get user.type 2>/dev/null)

# The tag and folder that will be used for trash
trash=$(notmuch config get user.trash) || exit "$?"

# The tag and folder that will be used for archiving
archive=$(notmuch config get user.archive) || exit "$?"

# The folder that will be used for sent mail
sent=$(notmuch config get user.sent) || exit "$?"

tags="$(notmuch config get user.folder_tags 2>/dev/null)"

# Add a copy of all emails with a tag to a maildir folder
tag_to_folder() {
    # Usage: tag_to_folder "tag" "folder"
    tag="$1"
    folder="$2"
    # Some accounts don't have a folder for every tag. Without a folder,
    # insert would put the message in the account root instead.
    if [ -z "${folder}" ]; then
        printf 'Skipping tag_to_folder for tag "%s": no folder configured\n' "${tag}" >&2
        return 0
    fi
    messages=$(notmuch search --output=messages --exclude=false tag:${tag} and not folder:"\"${folder}\"") || return 1
    while IFS= read -r message && [ -n "${message}" ];
    do
        files="$(notmuch search --output=files --exclude=false ${message})" || return 1
        # Check the folder beneath this account's root. A copy in Other/Work
        # doesn't count as a copy in Work.
        existing="$(printf '%s\n' "${files}" | grep -F -- "${dir}/${folder}/")"
        if [ -z "${existing}" ];
        then
            file=$(printf '%s\n' "${files}" | head -n1)
            printf "Copying %s to %s\n" "${file}" "${folder}"
            # Index the copy as we make it. If something fails later, the next
            # run needs to find it without making another copy. insert keeps
            # the message's tags and writes its flags without carrying over T.
            if ! notmuch insert --no-hooks --folder="${folder}" < "${file}"; then
                printf "Failed to copy %s to %s; retaining the source\n" "${file}" "${folder}" >&2
                return 1
            fi
        fi
    done <<eof
${messages}
eof
}

folder_prune() {
    # Usage: folder_prune "tag" "folder"
    tag="$1"
    folder="$2"
    query="folder:\"${folder}\" and not tag:${tag}"
    # If this account doesn't use the tag, there's no folder to prune.
    if [ -z "${folder}" ]; then
        printf 'Skipping folder_prune for tag "%s": no folder configured\n' "${tag}" >&2
        return 0
    fi
    prune_files=$(notmuch search --output=files --exclude=false "${query}") || return 1
    [ -n "${prune_files}" ] || return 0
    prune_failed=0
    while IFS= read -r file && [ -n "${file}" ];
    do
        # A message can have files in several folders. Only remove the copy
        # in this one: Inbox mustn't match InboxArchive, and [] is literal.
        case "${file}" in
            "${dir}/${folder}/"*)
                printf "Deleting %s -- doesn't have %s\n" "${file}" "${tag}"
                if ! rm -f "${file}"; then
                    printf "Failed to delete %s; retaining the source\n" "${file}" >&2
                    prune_failed=1
                fi
            ;;
        esac
    done <<eof
${prune_files}
eof
    # We've removed the files, but Notmuch still has their old names. Clear
    # those references before syncing, so a failed sync doesn't leave retries
    # trying to copy missing files. Reindex only these messages; a full scan
    # would pick up new arrivals before post-new has sorted out their tags.
    if ! notmuch reindex -- "${query}"; then
        printf 'Failed to reindex pruned messages in %s; stopping before synchronization\n' "${folder}" >&2
        exit 1
    fi
    return "${prune_failed}"
}

copy_failed=0
prune_failed_any=0

tag_to_folder deleted "${trash}" || copy_failed=1
tag_to_folder inbox "${inbox}" || copy_failed=1
tag_to_folder sent "${sent}" || copy_failed=1

while IFS= read -r tag && [ -n "${tag}" ];
do
    tag_to_folder "${tag}" "$(notmuch config get user."${tag}")" || copy_failed=1
done <<eof
${tags}
eof

# If it doesn't have a tag, then mark it as archived
notmuch tag +archive -- not tag:archive and not tag:inbox and not tag:deleted and not tag:sent $(printf "${tags}" | sed 's/^/and not tag:/') || copy_failed=1

tag_to_folder archive "${archive}" || copy_failed=1

# If a copy failed, keep the old files until we can try again. We can still
# sync the copies that worked, but mustn't run post-new: an inbox file we
# failed to remove could look like a remote move back to the inbox.
if [ "${copy_failed}" -eq 0 ]; then
    folder_prune deleted "${trash}" || prune_failed_any=1
    folder_prune inbox "${inbox}" || prune_failed_any=1
    while IFS= read -r tag && [ -n "${tag}" ];
    do
        folder_prune "${tag}" "$(notmuch config get user."${tag}")" || prune_failed_any=1
    done <<eof
${tags}
eof
    if [ -z "${gmail}" ]; then
        folder_prune archive "${archive}" || prune_failed_any=1
    fi
else
    printf "Copy phase failed; skipping folder pruning until the next run\n" >&2
fi

# Wait for mbsync before Notmuch scans the downloaded files. If any copies
# or removals failed, tell Notmuch to leave post-new for later.
mbsync -- "${mbdir}" || exit "$?"
[ "${copy_failed}" -eq 0 ] && [ "${prune_failed_any}" -eq 0 ]
