#!/bin/sh

# Shell script to update and activate the current Nix configuration.
# `local` is supported by the shells used for this script, including Dash.

set -e

# Nix command flags for experimental features.
NIX_FLAGS="--extra-experimental-features nix-command --extra-experimental-features flakes $NIX_FLAGS"

# Keep the flake location and resource policy in one place.  The two pseudo-
# inputs are package-local resources that are refreshed alongside the flake.
FLAKE_DIR="${HOME}/.config/nixpkgs"
DEFAULT_EXCLUDED_INPUTS="obsidian-headless model-benchmarks"
PSEUDO_INPUTS="obsidian-headless model-benchmarks"

# Dash does not implement Bash's $'...' quoting.  printf also gives these
# values the same escape sequences when the script is run by /bin/sh.
blue=$(printf '\033[38;5;4m')
green=$(printf '\033[38;5;85m')
red=$(printf '\033[38;5;1m')
orange=$(printf '\033[38;5;208m')
cyan=$(printf '\033[38;5;6m')
bold=$(printf '\033[1m')
reset=$(printf '\033[m')

# Values resolved during preflight.
SYSTEM_TYPE=""
HAS_SYSTEM=false
HAS_HOME=false
MODE=""
TARGET_CONFIG=""
FLAKE_ATTR=""
ALL_INPUTS=""
SELECTED_REAL_INPUTS=""
SELECTED_PSEUDO_INPUTS=""
SKIPPED_INPUTS=""

print_info() {
    printf '%s[INFO]%s %s\n' "$blue" "$reset" "$1"
}

print_success() {
    printf '%s[SUCCESS]%s %s\n' "$green" "$reset" "$1"
}

print_error() {
    printf '%s[ERROR]%s %s\n' "$red" "$reset" "$1" >&2
}

print_warning() {
    printf '%s[WARNING]%s %s\n' "$orange" "$reset" "$1"
}

list_contains() {
    local list="$1"
    local item="$2"
    local value

    for value in $list; do
        if [ "$value" = "$item" ]; then
            return 0
        fi
    done
    return 1
}

list_add() {
    local list="$1"
    local item="$2"

    if list_contains "$list" "$item"; then
        printf '%s\n' "$list"
    elif [ -n "$list" ]; then
        printf '%s %s\n' "$list" "$item"
    else
        printf '%s\n' "$item"
    fi
}

detect_system() {
    case "$(uname -s)" in
        Darwin)
            SYSTEM_TYPE=darwin
            command -v darwin-rebuild >/dev/null 2>&1 && HAS_SYSTEM=true
            ;;
        Linux)
            SYSTEM_TYPE=linux
            command -v nixos-rebuild >/dev/null 2>&1 && HAS_SYSTEM=true
            ;;
        *)
            print_error "Unsupported system: $(uname -s)"
            exit 1
            ;;
    esac

    if command -v home-manager >/dev/null 2>&1; then
        HAS_HOME=true
    fi
}

detect_home_config() {
    local username="$(whoami)"

    # Hostnames are intentionally not used here: an SSH session identifies a
    # server even when that server has an arbitrary hostname.
    if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ] || [ "$(ps -o comm= -p "$PPID")" = "sshd" ]; then
        printf '%s@server\n' "$username"
    elif [ "$username" = toma ]; then
        printf '%s\n' "$username@work"
    else
        printf '%s\n' "$username@personal"
    fi
}

show_modes() {
    print_info "Available update modes on ${SYSTEM_TYPE}:"
    if [ "$HAS_SYSTEM" = true ]; then
        if [ "$SYSTEM_TYPE" = darwin ]; then
            print_info "  ${bold}system${reset} - Update nix-darwin system configuration"
        else
            print_info "  ${bold}system${reset} - Update NixOS system configuration"
        fi
    fi
    if [ "$HAS_HOME" = true ]; then
        print_info "  ${bold}home${reset} - Update home-manager configuration"
    fi
}

resolve_target() {
    local requested_mode="$1"
    local config_override="$2"

    if [ -z "$requested_mode" ]; then
        if [ "$HAS_SYSTEM" = true ]; then
            requested_mode=system
        elif [ "$HAS_HOME" = true ]; then
            requested_mode=home
        else
            print_error "No rebuild command or home-manager is available"
            exit 1
        fi
    fi

    case "$requested_mode" in
        system)
            if [ "$HAS_SYSTEM" != true ]; then
                print_error "System configuration is not available on this system"
                show_modes
                exit 1
            fi
            MODE=system
            TARGET_CONFIG="${config_override:-$(hostname)}"
            case "$SYSTEM_TYPE" in
                darwin) FLAKE_ATTR=darwinConfigurations ;;
                linux) FLAKE_ATTR=nixosConfigurations ;;
            esac
            ;;
        home)
            if [ "$HAS_HOME" != true ]; then
                print_error "Home-manager is not available on this system"
                show_modes
                exit 1
            fi
            MODE=home
            TARGET_CONFIG="${config_override:-$(detect_home_config)}"
            FLAKE_ATTR=homeConfigurations
            ;;
        both)
            print_error "The 'both' mode has been removed; integrated system configurations include Home Manager"
            show_modes
            exit 1
            ;;
        *)
            print_error "Invalid mode: $requested_mode"
            show_modes
            exit 1
            ;;
    esac

    print_info "Update mode: ${bold}${MODE}${reset}"
    print_info "Configuration: ${bold}${TARGET_CONFIG}${reset}"
}

check_config_exists() {
    local config_attrs
    local available

    if [ ! -f "${FLAKE_DIR}/flake.nix" ]; then
        print_error "Flake not found at ${FLAKE_DIR}/flake.nix"
        exit 1
    fi
    if ! command -v jq >/dev/null 2>&1; then
        print_error "jq is required to inspect flake metadata"
        exit 1
    fi

    # Evaluate only the fixed output attribute, and compare the user supplied
    # configuration name as data with jq.  This avoids putting that name into
    # Nix source and keeps evaluation read-only.
    if ! config_attrs=$(nix eval ${NIX_FLAGS} --no-write-lock-file --json \
        "${FLAKE_DIR}#${FLAKE_ATTR}" --apply builtins.attrNames); then
        print_error "Could not evaluate ${FLAKE_ATTR} from ${FLAKE_DIR}"
        exit 1
    fi
    if printf '%s\n' "$config_attrs" | jq -e --arg config "$TARGET_CONFIG" \
        'index($config) != null' >/dev/null; then
        return 0
    fi

    print_error "Configuration '${TARGET_CONFIG}' not found in ${FLAKE_ATTR}"
    available=$(printf '%s\n' "$config_attrs" | jq -r '.[]' | tr '\n' ' ')
    print_info "Available configurations: ${available}"
    exit 1
}

get_flake_inputs() {
    local metadata

    if ! metadata=$(nix flake metadata ${NIX_FLAGS} --no-write-lock-file --json "$FLAKE_DIR"); then
        print_error "Could not inspect flake metadata"
        exit 1
    fi

    # Metadata's lock graph names its root node explicitly.  Reading that
    # node handles flakes whose root is not literally named `root` and avoids
    # consulting a possibly stale flake.lock directly.
    if ! printf '%s\n' "$metadata" | jq -r '
        .locks as $locks
        | ($locks.nodes[$locks.root].inputs // {})
        | keys[]
    '; then
        print_error "Could not read root inputs from flake metadata"
        exit 1
    fi
}

validate_explicit_inputs() {
    local input

    for input in $MENTIONED_INPUTS; do
        if list_contains "$PSEUDO_INPUTS" "$input"; then
            continue
        fi
        if ! list_contains "$ALL_INPUTS" "$input"; then
            print_error "Unknown input: '$input'"
            print_info "Available inputs: $(printf '%s\n' "$ALL_INPUTS" | tr '\n' ' ')"
            exit 1
        fi
    done
}

validate_default_exclusions() {
    local input

    for input in $DEFAULT_EXCLUDED_INPUTS; do
        if ! list_contains "$PSEUDO_INPUTS" "$input" && \
            ! list_contains "$ALL_INPUTS" "$input"; then
            print_warning "Excluded input '$input' does not exist in flake"
        fi
    done
}

# Selection is deliberately centralized.  For every real or pseudo input the
# invariant is: explicit exclusion > explicit inclusion > --none > --all >
# default and platform/server exclusions.  Thus flag order cannot change the
# result, and explicit includes can opt into a normally filtered input.
resource_selected() {
    local input="$1"

    if list_contains "$EXPLICIT_EXCLUDES" "$input"; then
        return 1
    fi
    if list_contains "$EXPLICIT_INCLUDES" "$input"; then
        return 0
    fi
    if [ "$USE_NONE" = true ]; then
        return 1
    fi
    if [ "$USE_ALL" = true ]; then
        return 0
    fi
    if list_contains "$DEFAULT_EXCLUDED_INPUTS" "$input"; then
        return 1
    fi

    case "$SYSTEM_TYPE:$TARGET_CONFIG:$input" in
        linux:*:nixpkgs-darwin|linux:*:nix-darwin)
            return 1
            ;;
        darwin:*:codex-desktop-linux)
            return 1
            ;;
        *server*:zen-browser|*server*:codex-desktop-linux)
            return 1
            ;;
    esac
    return 0
}

select_inputs() {
    local input

    SELECTED_REAL_INPUTS=""
    SELECTED_PSEUDO_INPUTS=""
    SKIPPED_INPUTS=""
    # Metadata keys and the separate pseudo-input names are unique, so these
    # result lists can be appended directly without deduplication or removal.
    for input in $ALL_INPUTS $PSEUDO_INPUTS; do
        if ! resource_selected "$input"; then
            SKIPPED_INPUTS="${SKIPPED_INPUTS:+$SKIPPED_INPUTS }$input"
        elif list_contains "$PSEUDO_INPUTS" "$input"; then
            SELECTED_PSEUDO_INPUTS="${SELECTED_PSEUDO_INPUTS:+$SELECTED_PSEUDO_INPUTS }$input"
        else
            SELECTED_REAL_INPUTS="${SELECTED_REAL_INPUTS:+$SELECTED_REAL_INPUTS }$input"
        fi
    done
}

pseudo_script() {
    case "$1" in
        model-benchmarks)
            printf '%s\n' "${FLAKE_DIR}/modules/home-manager/profiles/development/ai-skills/model-selection/update.sh"
            ;;
        obsidian-headless)
            printf '%s\n' "${FLAKE_DIR}/packages/obsidian-headless/update.sh"
            ;;
        *)
            return 1
            ;;
    esac
}

validate_pseudo_updaters() {
    local pseudo
    local script

    for pseudo in $SELECTED_PSEUDO_INPUTS; do
        if ! script=$(pseudo_script "$pseudo"); then
            print_error "No updater configured for pseudo-input: '$pseudo'"
            exit 1
        fi
        if [ ! -x "$script" ]; then
            print_error "Pseudo-input updater is missing or not executable: $script"
            exit 1
        fi
    done
}

show_selected_inputs() {
    local selected="${SELECTED_REAL_INPUTS:+$SELECTED_REAL_INPUTS }$SELECTED_PSEUDO_INPUTS"

    if [ -n "$SKIPPED_INPUTS" ]; then
        print_info "Skipping: ${cyan}${SKIPPED_INPUTS}${reset}"
    fi
    if [ -n "$selected" ]; then
        print_info "Updating: ${cyan}${selected}${reset}"
    fi
}

reconcile_flake() {
    print_info "Reconciling flake inputs..."
    if ! nix flake lock ${NIX_FLAGS} "$FLAKE_DIR"; then
        print_error "Failed to lock flake"
        exit 1
    fi
}

update_selected_inputs() {
    if [ -n "$SELECTED_REAL_INPUTS" ]; then
        if ! nix flake update ${NIX_FLAGS} $SELECTED_REAL_INPUTS --flake "$FLAKE_DIR"; then
            print_error "Failed to update flake inputs"
            exit 1
        fi
    else
        print_info "No flake inputs to update"
    fi
}

update_pseudo_inputs() {
    local pseudo
    local script

    for pseudo in $SELECTED_PSEUDO_INPUTS; do
        script=$(pseudo_script "$pseudo")
        print_info "Updating pseudo-input: ${cyan}${pseudo}${reset}"
        if ! "$script"; then
            print_error "Failed to update pseudo-input '${pseudo}'"
            exit 1
        fi
    done
}

update_system() {
    print_info "Switching to system configuration: ${bold}${TARGET_CONFIG}${reset}"

    case "$SYSTEM_TYPE" in
        darwin)
            if ! sudo darwin-rebuild switch --flake "${FLAKE_DIR}#${TARGET_CONFIG}"; then
                print_error "Failed to switch to darwin configuration '${TARGET_CONFIG}'"
                exit 1
            fi
            ;;
        linux)
            if ! sudo nixos-rebuild switch --flake "${FLAKE_DIR}#${TARGET_CONFIG}"; then
                print_error "Failed to switch to nixos configuration '${TARGET_CONFIG}'"
                exit 1
            fi
            ;;
    esac
    print_success "Successfully updated system configuration '${TARGET_CONFIG}'"
}

update_home() {
    print_info "Switching to home-manager configuration: ${bold}${TARGET_CONFIG}${reset}"
    if ! home-manager switch ${NIX_FLAGS} --flake "${FLAKE_DIR}#${TARGET_CONFIG}"; then
        print_error "Failed to switch to home-manager configuration '${TARGET_CONFIG}'"
        exit 1
    fi
    print_success "Successfully updated home-manager configuration '${TARGET_CONFIG}'"
}

show_help() {
    cat << EOF
Usage: $0 [OPTIONS] [MODE] [CONFIG_NAME]

Detects and updates one Nix configuration.

MODES:
  system    Update the nix-darwin or NixOS system configuration
  home      Update the home-manager configuration

If MODE is omitted, system is selected when a system rebuild command is
available; otherwise home-manager is selected.  The old 'both' mode is not
supported because integrated system configurations include Home Manager.

INPUT OPTIONS:
  --all           Refresh all real and pseudo inputs (ignore automatic exclusions)
  --none          Refresh only explicitly included inputs
  --<input>       Include <input> (overrides default and smart exclusions)
  --no-<input>    Exclude <input> (takes precedence over inclusion)

By default, these resources are excluded: ${DEFAULT_EXCLUDED_INPUTS}
Smart exclusions also remove nix-darwin inputs on Linux, codex-desktop-linux
on Darwin, and zen-browser plus codex-desktop-linux for server configurations.
Pseudo-inputs are refreshed by their package-local updater scripts.
Flags are order-independent: exclusions win over inclusions, and --none wins
over --all. Even with --none, flake.lock is reconciled with flake.nix before
rebuilding; it can change when input declarations have changed.

If CONFIG_NAME is provided, it is used instead of auto-detection.
System configs use the hostname. Home configs use username@server over SSH;
otherwise toma@work for user toma, and username@personal for other users.

Examples:
  $0
  $0 system
  $0 home
  $0 home toma@server
  $0 system apollo
  $0 --llm-agents
  $0 --all
  $0 --all --no-llm-agents
  $0 --none
  $0 --none --nixpkgs
  $0 --none --obsidian-headless
  $0 --none --model-benchmarks
EOF
}

parse_input_flags() {
    local input_name
    local positional_count=0

    USE_ALL=false
    USE_NONE=false
    EXPLICIT_INCLUDES=""
    EXPLICIT_EXCLUDES=""
    MENTIONED_INPUTS=""
    MODE_ARG=""
    CONFIG_ARG=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --all) USE_ALL=true ;;
            --none) USE_NONE=true ;;
            --no-*)
                input_name=${1#--no-}
                if [ -z "$input_name" ]; then
                    print_error "Input name cannot be empty"
                    exit 1
                fi
                EXPLICIT_EXCLUDES=$(list_add "$EXPLICIT_EXCLUDES" "$input_name")
                MENTIONED_INPUTS=$(list_add "$MENTIONED_INPUTS" "$input_name")
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            --*)
                input_name=${1#--}
                if [ -z "$input_name" ]; then
                    print_error "Input name cannot be empty"
                    exit 1
                fi
                EXPLICIT_INCLUDES=$(list_add "$EXPLICIT_INCLUDES" "$input_name")
                MENTIONED_INPUTS=$(list_add "$MENTIONED_INPUTS" "$input_name")
                ;;
            *)
                positional_count=$((positional_count + 1))
                case "$positional_count" in
                    1) MODE_ARG=$1 ;;
                    2) CONFIG_ARG=$1 ;;
                    *)
                        print_error "Too many positional arguments: '$1'"
                        show_help
                        exit 1
                        ;;
                esac
                ;;
        esac
        shift
    done

    if [ "$USE_ALL" = true ] && [ "$USE_NONE" = true ]; then
        print_warning "'--all' and '--none' both specified; using '--none'"
        USE_ALL=false
    fi
    for input_name in $EXPLICIT_INCLUDES; do
        if list_contains "$EXPLICIT_EXCLUDES" "$input_name"; then
            print_warning "'$input_name' was both included and excluded; excluding"
        fi
    done
}

main() {
    detect_system
    resolve_target "$MODE_ARG" "$CONFIG_ARG"

    # Everything through this point is read-only.  In particular, metadata
    # and configuration evaluation happen before lock reconciliation.
    check_config_exists
    ALL_INPUTS=$(get_flake_inputs)
    validate_explicit_inputs
    validate_default_exclusions
    select_inputs
    validate_pseudo_updaters
    show_selected_inputs

    reconcile_flake
    update_selected_inputs
    update_pseudo_inputs

    if [ "$MODE" = system ]; then
        update_system
    else
        update_home
    fi
}

parse_input_flags "$@"
main
