#!/bin/sh
# This file does some preprocessing for notmuch by putting some special tags
# in the correct maildir directories.

# It requires some special setup to work correctly:
#  - notmuch configurations are in .config/notmuch/{name}
#  - mail is kept in ~/.mail/{name}
#  - the database path is in ~/.mail/{name}/.notmuch
#  - the mbsync channel that needs to be run is called {name}
#  - if gmail is being used, `notmuch config set user.type gmail` has been run
#  - hook_dir is set to ~/.config/notmuch/hooks in the notmuch config

# NOTMUCH_CONFIG is set by notmuch when running hooks
if [ -z "${NOTMUCH_CONFIG}" ]; then
    echo "Error: NOTMUCH_CONFIG is not set. This hook must be run via notmuch." >&2
    exit 1
fi

conf_file="${NOTMUCH_CONFIG}"
mbdir="${conf_file##*/}"
dir="${HOME}/.mail/${mbdir}"

# Are we using gmail or not?
gmail=$(notmuch config get user.type 2>/dev/null)

# The tag and folder that will be used for trash
trash=$(notmuch config get user.trash 2>/dev/null)
trash=${trash:-${gmail:+'[Gmail]/Trash'}}
trash=${trash:-'Trash'}

# The tag and folder that will be used for archiving
archive=$(notmuch config get user.archive 2>/dev/null)
archive=${archive:-${gmail:+'[Gmail]/All Mail'}}
archive=${archive:-'Archive'}

# The folder that will be used for sent mail
sent=$(notmuch config get user.sent 2>/dev/null)
sent=${sent:-${gmail:+'[Gmail]/Sent Mail'}}
sent=${sent:-'Sent'}

tags="$(notmuch config get user.folder_tags 2>/dev/null)"

# Add a copy of all emails with a tag to a maildir folder
tag_to_folder() {
    # Usage: tag_to_folder "tag" "folder"
    tag="$1"
    folder="$2"
    # An unconfigured optional tag is a no-op, not a copy failure: without a
    # folder the grep guard collapses to `//` and cp would land in the
    # maildir root. Return 0 so copy_failed still reflects real IO errors.
    if [ -z "${folder}" ]; then
        printf 'Skipping tag_to_folder for tag "%s": no folder configured\n' "${tag}" >&2
        return 0
    fi
    while IFS= read -r message && [ -n "${message}" ];
    do
        files="$(notmuch search --output=files --exclude=false ${message})"
        # Match the configured folder as a literal path segment.
        existing="$(printf '%s\n' "${files}" | grep -F -i -- "/${folder}/")"
        if [ -z "${existing}" ];
        then
            file=$(printf '%s\n' "${files}" | head -n1)
            printf "Copying %s to %s\n" "${file}" "${folder}"
            name="${file##*/}"
            # Get the IMAP flags
            flags="${name##*:}"
            directory=${file%%/${name}}
            # If its in the "new" directory, we need to set the flags ourselves
            if [ "${directory##*/}" = "new" ]; then flags="2,"; fi
            if ! cp -f "${file}" "${dir}/${folder}/cur/$(uuidgen):${flags%%T}"; then
                printf "Failed to copy %s to %s; retaining the source\n" "${file}" "${folder}" >&2
                return 1
            fi
        fi
    done <<eof
$(notmuch search --output=messages --exclude=false tag:${tag} and not folder:"\"${folder}\"")
eof
}

folder_prune() {
    # Usage: folder_prune "tag" "folder"
    tag="$1"
    folder="$2"
    # Without a configured folder the case pattern below (*""*) matches every
    # path, which would silently delete unrelated mail. Skip instead.
    if [ -z "${folder}" ]; then
        printf 'Skipping folder_prune for tag "%s": no folder configured\n' "${tag}" >&2
        return 0
    fi
    while IFS= read -r file && [ -n "${file}" ];
    do
        case "${file}" in
            */"${folder}"/*) # Match the folder as a literal path segment
                             # to avoid, e.g., an `Inbox` prune touching
                             # `InboxArchive/`. The folder itself needs to
                             # be quoted for special characters (e.g. `[]`).
                printf "Deleting %s -- doesn't have %s\n" "${file}" "${tag}"
                if ! rm -f "${file}"; then
                    printf "Failed to delete %s; retaining the source\n" "${file}" >&2
                fi
            ;;
        esac
    done <<eof
$(notmuch search --output=files --exclude=false folder:"\"${folder}\"" and not tag:${tag})
eof
}

copy_failed=0

tag_to_folder deleted "${trash}" || copy_failed=1
tag_to_folder inbox INBOX || copy_failed=1
tag_to_folder inbox Inbox || copy_failed=1
tag_to_folder sent "${sent}" || copy_failed=1

while IFS= read -r tag && [ -n "${tag}" ];
do
    tag_to_folder "${tag}" "$(notmuch config get user."${tag}")" || copy_failed=1
done <<eof
${tags}
eof

# If it doesn't have a tag, then mark it as archived
notmuch tag +archive -- not tag:archive and not tag:inbox and not tag:deleted and not tag:sent $(printf "${tags}" | sed 's/^/and not tag:/')

tag_to_folder archive "${archive}" || copy_failed=1

# Pruning is destructive, so gate it on a fully successful copy phase. Copies
# are idempotent (tag_to_folder skips folders that already contain the
# message), so the next run reconciles anything that was skipped here. Return
# 0 either way so notmuch still runs post-new (T-flag maildir moves) and the
# mbsync push below still propagates the copies that did succeed.
if [ "${copy_failed}" -eq 0 ]; then
    folder_prune deleted "${trash}"
    folder_prune inbox INBOX
    folder_prune inbox Inbox
    while IFS= read -r tag && [ -n "${tag}" ];
    do
        folder_prune "${tag}" "$(notmuch config get user."${tag}")"
    done <<eof
${tags}
eof
    [ -z "${gmail}" ] && folder_prune archive "${archive}"
else
    printf "Copy phase failed; skipping folder pruning until the next run\n" >&2
fi

mbsync "${mbdir}"
