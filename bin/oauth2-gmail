#!/bin/sh

# ~/bin precedes the Home Manager profile on PATH. Forward to its packaged
# command, skipping this launcher even through another symlink or PATH entry.
remaining_path="${PATH-}:"
while [ -n "$remaining_path" ]; do
    command_dir=${remaining_path%%:*}
    remaining_path=${remaining_path#*:}
    candidate="${command_dir:-.}/oauth2-gmail"
    if [ -f "$candidate" ] && [ -x "$candidate" ] && ! [ "$candidate" -ef "$0" ]; then
        exec "$candidate" "$@"
    fi
done

echo 'oauth2-gmail: packaged command missing from PATH; activate the mail profile and load its environment.' >&2
exit 127
